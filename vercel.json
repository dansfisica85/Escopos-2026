{
  "buildCommand": "cd escopo-sequencia && npm install && npm run build",
  "outputDirectory": "escopo-sequencia/dist/escopo-sequencia/browser",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}
